# Database Configuration (PostgreSQL in production, SQLite for local testing: sqlite:///./society_db.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/society_db

# Security & JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- SMTP Email Configuration Options ---

# Option A: Free Gmail App Password
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an app password named 'SocietyTracker' and copy the 16-character code
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Option B: SendGrid Free Tier (100 emails/day)
# 1. Create a free account at https://sendgrid.com
# 2. Create an API Key with 'Mail Send' permissions
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key

# Cloudinary Storage for photo uploads (optional, falls back to local /uploads)
CLOUDINARY_URL=cloudinary://key:secret@cloudname
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Business Logic Settings
OVERDUE_THRESHOLD_DAYS=7
FRONTEND_URL=http://localhost:5173
